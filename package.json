{
	"name": "harness-kernel",
	"version": "0.3.0",
	"description": "A test kernel that knows nothing about any target: the run, the eight verdicts, the ledgers and the reporting",
	"license": "MIT",
	"author": "Luis Tineo <code@kingletas.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kingletas/harness-kernel.git"
	},
	"bugs": {
		"url": "https://github.com/kingletas/harness-kernel/issues"
	},
	"homepage": "https://github.com/kingletas/harness-kernel#readme",
	"keywords": [
		"testing",
		"test-harness",
		"acceptance-testing",
		"regression-testing",
		"flaky-tests",
		"quarantine",
		"verdicts",
		"test-kernel"
	],
	"type": "module",
	"engines": {
		"node": ">=20.19.0"
	},
	"main": "./dist/src/index.js",
	"types": "./dist/src/index.d.ts",
	"exports": {
		".": "./dist/src/index.js"
	},
	"files": [
		"dist",
		"src",
		"bin",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"bin": {
		"harness-selfcheck": "./bin/harness-selfcheck"
	},
	"scripts": {
		"build": "tsc -p .",
		"prepare": "tsc -p .",
		"typecheck": "tsc --noEmit -p .",
		"test": "cd dist && node --test",
		"lint": "eslint .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@eslint/js": "^9.39.0",
		"@types/node": "^20.19.9",
		"eslint": "^9.39.0",
		"prettier": "^3.9.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.68.0"
	}
}
