#!/usr/bin/env bash
#
# Thin wrapper so the command is `harness-selfcheck` rather than a path into dist/.
# The CLI resolves the package root from this file's own location, so the link
# chain below has to be followed before that path means anything.
#
# Node bundles its own CA list and ignores the system trust store, so a target
# served over a locally-issued certificate fails verification here even though
# curl and every browser on this machine accept it. The mkcert root is added
# when it exists. Verification is never disabled -- a harness that skips TLS
# checks cannot make any statement about a target's TLS.
set -euo pipefail

# npm installs a bin as a symlink under node_modules/.bin, so the path this was
# invoked by is not where the code is. Follow the link chain to the real file
# before resolving dist/, or an installed copy looks for main.js beside the
# symlink and fails with a module it cannot find.
source="${BASH_SOURCE[0]}"
while [[ -L "$source" ]]; do
	target=$(readlink "$source")
	if [[ $target == /* ]]; then
		source="$target"
	else
		source="$(cd "$(dirname "$source")" && pwd)/$target"
	fi
done

here=$(cd "$(dirname "$source")" && pwd)

if [[ -z "${NODE_EXTRA_CA_CERTS:-}" ]]; then
	for ca in "${HOME}/.local/share/mkcert/rootCA.pem" "/usr/local/share/ca-certificates/mkcert"*.crt; do
		if [[ -r "$ca" ]]; then
			export NODE_EXTRA_CA_CERTS="$ca"
			break
		fi
	done
fi

exec node "${here}/../dist/src/cli/main.js" "$@"
